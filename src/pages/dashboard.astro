---
import Layout from "../components/Layout.astro"
import { serviceSupabase, supabase } from "../lib/supabase"
import MeetingsList from "../components/MeetingsList.astro"
import MemberDashboard from "../components/MemberDashboard.astro"
import MemberSearch from "../components/MemberSearch.astro"
import BackLink from "../components/BackLink.astro"
import Battery from "../components/Battery.astro"
import StudentsList from "../components/StudentsList.astro"
import TopBar from "../components/TopBar.astro"
import { formatMeetingDate, formatPercent, todayAtShop } from "../lib/format"
import { meetingCells, teamCells } from "../lib/charge"
import { memberDays, type DayStats } from "../lib/days"
import { isAdmin } from "../lib/access"

// checks if the user is logged in through the cookies
// if they aren"t logged in then we redirect them to login
const accessToken = Astro.cookies.get("sb-access-token")
const refreshToken = Astro.cookies.get("sb-refresh-token")
if (!accessToken || !refreshToken) return Astro.redirect("/")

// handles session
let session
try {
    // uses the cookies to set the session
    session = await supabase.auth.setSession({
        refresh_token: refreshToken.value,
        access_token: accessToken.value,
    })

    // if there"s an error then the tokens are deleted and user is redirected to login
    if (session.error) {
        Astro.cookies.delete("sb-access-token", {
            path: "/",
        })
        Astro.cookies.delete("sb-refresh-token", {
            path: "/",
        })

        return Astro.redirect("/")
    }
} catch (error) {
    // same thing as above error handling
    Astro.cookies.delete("sb-access-token", {
        path: "/",
    })
    Astro.cookies.delete("sb-refresh-token", {
        path: "/",
    })
    return Astro.redirect("/")
}

// the osis is stored as email in the supabase database
let osis = session.data.user?.email?.split("@")[0]

export interface Meeting {
    date: string
    attendees: { id: string; total_hours: string; checkin_time: string; checkout_time: string }[]
    num_checkins: string
    num_checkouts: string
    checkout_rate_percent: string
}

let allMeetings: string[] = []
let userData
let meetings: Meeting[] = []
let days: Record<string, DayStats> = {}

// a battery with only a few people in it looks like a mistake, so small meetings skip it
const MIN_MEETING_BATTERY = 8

// only used to show the admin a way back to the meetings list
const viewerIsAdmin = isAdmin(osis)

// who actually logged in, before the search params can change osis
const signedInOsis = osis

// if the user is the admin use search params for osis
osis = Astro.url.searchParams.get("osis") || osis

let meeting = Astro.url.searchParams.get("meeting")

// set when an admin opens a member from a meeting page; only a real date is kept
const from = Astro.url.searchParams.get("from")
const fromMeeting = from && /^\d{4}-\d{2}-\d{2}$/.test(from) ? from : null

let meetingInfo: Meeting | null = null
let names: Record<string, string> = {}
// first and last names kept apart, so the meeting page can sort by either
let nameParts: Record<string, { first: string; last: string }> = {}
let roster: { id: string; name: string }[] = []

if (osis) {
    if (!isAdmin(osis)) {
        // gets the user row from the database
        const { data, error } = await supabase
            .from("attendance")
            .select("*")
            .in("id_number", [osis, "all"])
            .order("id_number", { ascending: true })

        if (error) console.error("error fetching user data")
        else {
            userData = data[0]
            allMeetings = data[1].checked_out
        }

        // the member's own times at each meeting, for the calendar's day details.
        // members can't read the meetings table themselves, so the server reads it and
        // memberDays keeps only this member's times. only for your own page, or the admin's view
        if (osis === signedInOsis || viewerIsAdmin) {
            const { data: meetingRows, error: meetingsError } = await serviceSupabase
                .from("meetings")
                .select("date, attendees")

            if (meetingsError) console.error("error fetching meeting times")
            else days = memberDays(meetingRows, osis)
        }
    } else {
        // the database only lets the original admin account read meetings, so any other
        // admin's view is read by the server. this checks who logged in, not the url's osis
        const adminClient = viewerIsAdmin ? serviceSupabase : supabase

        const { data, error } = await adminClient.from("meetings").select("*")

        if (error) console.error("error fetching meetings data")
        else meetings = data

        // everyone on the roster, for the search's suggestions. only an admin who logged in gets it
        if (viewerIsAdmin && !meeting) {
            const { data, error } = await adminClient
                .from("attendance")
                .select("id_number, first_name, last_name")
                .neq("id_number", "all")

            if (error) console.error("error fetching the roster")
            else
                roster = data
                    .map(({ id_number, first_name, last_name }) => ({
                        id: id_number,
                        name: [first_name, last_name].filter(Boolean).join(" "),
                    }))
                    .sort((a, b) => (a.name || a.id).localeCompare(b.name || b.id))
        }

        if (meeting) {
            const { data, error } = await adminClient.from("meetings").select("*").eq("date", meeting)

            if (error) console.error("error fetching meeting data")
            else {
                meetingInfo = data[0] as Meeting

                const { data: data1, error } = await adminClient
                    .from("attendance")
                    .select("id_number, first_name, last_name")
                    .in(
                        "id_number",
                        meetingInfo.attendees.map(({ id }) => id),
                    )

                if (error) console.error("error fetching user names")
                else {
                    data1.forEach(({ id_number, first_name, last_name }) => {
                        if (first_name && last_name) {
                            names[id_number] = first_name + " " + last_name
                            nameParts[id_number] = { first: first_name, last: last_name }
                        }
                    })
                }
            }
        }
    }
}
---

<Layout title="Dashboard | MyPulse" desc="Track attendance and see upcoming events for StuyPulse">
    {
        // admin dashboard or meeting page
        isAdmin(osis) ? (
            <>
                <TopBar />
                {
                    // meeting page
                    meeting && meetingInfo ? (
                        <main class="page-width pb-16">
                            <nav class="mt-4" aria-label="Back">
                                <BackLink href="/dashboard" label="All meetings" />
                            </nav>
                            <h1 class="headline mt-4">{formatMeetingDate(meeting)}</h1>
                            <dl class="flex flex-wrap gap-x-10 gap-y-3 mt-6 mb-8 lg:mb-10">
                                <div class="flex flex-col-reverse">
                                    <dt class="text-[15px] text-soft">checked in</dt>
                                    <dd class="figure text-[32px]">{meetingInfo.num_checkins}</dd>
                                </div>
                                <div class="flex flex-col-reverse">
                                    <dt class="text-[15px] text-soft">checked out</dt>
                                    <dd class="figure text-[32px]">{meetingInfo.num_checkouts}</dd>
                                </div>
                                <div class="flex flex-col-reverse">
                                    <dt class="text-[15px] text-soft">checkout rate</dt>
                                    <dd class="figure text-[32px]">
                                        {formatPercent(meetingInfo.checkout_rate_percent)}
                                    </dd>
                                </div>
                            </dl>
                            {meetingInfo.attendees.length >= MIN_MEETING_BATTERY && (
                                <>
                                    <Battery cells={meetingCells(meetingInfo.attendees, names)} />
                                    <div class="mb-10" />
                                </>
                            )}
                            <StudentsList meetingInfo={meetingInfo} names={names} nameParts={nameParts} />
                        </main>
                    ) : (
                        // if no meeting then just display the admin dashboard with student search and meetings list
                        <main class="page-width pb-16">
                            <div class="grid lg:grid-cols-[minmax(0,1fr)_340px] items-end gap-x-16 gap-y-8 mt-12 lg:mt-20 mb-8 lg:mb-10">
                                <div>
                                    <p class="text-soft mb-3">Team 694</p>
                                    <h1 class="headline">Meetings</h1>
                                </div>
                                <MemberSearch members={roster} />
                            </div>
                            <Battery cells={teamCells(meetings, todayAtShop())} emptyText="No meetings yet." />
                            <div class="mb-10" />
                            <MeetingsList
                                meetings={meetings.sort((a, b) => {
                                    return b.date.localeCompare(a.date)
                                })}
                            />
                        </main>
                    )
                }
            </>
        ) : (
            // user dashboard
            <MemberDashboard
                userData={userData}
                allMeetings={allMeetings}
                osis={osis}
                viewerIsAdmin={viewerIsAdmin}
                days={days}
                fromMeeting={fromMeeting}
            />
        )
    }

    <script>
        const searchForm = document.getElementById("form")

        searchForm?.addEventListener("submit", async (event) => {
            event.preventDefault()

            const data = new FormData(searchForm as HTMLFormElement)

            const response = await fetch("/api/post/search", {
                method: "POST",
                body: data,
            })

            const text = await response.text()
            if (response.ok) window.location.href = text
            else {
                const error = document.getElementById("error")
                error!.textContent = text
            }
        })
    </script>
</Layout>
