---
// the selected meeting's times, filled in by the calendar's script
---

<div id="day-detail" class="hidden pt-5 border-t border-line" aria-live="polite">
    <div class="flex items-center justify-between gap-3 mb-4">
        <h2 id="day-date" class="section-title"></h2>
        <span id="day-status" class="day-chip"></span>
    </div>
    <dl id="day-times" class="grid grid-cols-3 gap-4">
        <div class="flex flex-col-reverse justify-end"><dt class="text-[14px] text-soft">checked in</dt><dd id="day-in" class="figure text-[22px]"></dd></div>
        <div class="flex flex-col-reverse justify-end"><dt class="text-[14px] text-soft">checked out</dt><dd id="day-out" class="figure text-[22px]"></dd></div>
        <div class="flex flex-col-reverse justify-end"><dt class="text-[14px] text-soft">hours</dt><dd id="day-hours" class="figure text-[22px]"></dd></div>
    </dl>
    <p id="day-missed" class="hidden">You didn't check in.</p>
    <p id="day-no-times" class="hidden text-soft">No times were saved for this meeting.</p>
</div>
