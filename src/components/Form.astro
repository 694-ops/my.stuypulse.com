---
interface Props {
    type: "login" | "signup"
}

const { type } = Astro.props
---

<form id="form" class="flex flex-col gap-4">
    <div class="flex flex-col gap-1">
        <label for="osis" class="text-[15px] font-medium">OSIS</label>
        <input
            class="field"
            name="osis"
            id="osis"
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
        />
    </div>

    <div class="flex flex-col gap-1">
        <label for="password" class="text-[15px] font-medium">Password</label>
        <input
            class="field"
            type="password"
            name="password"
            id="password"
            autocomplete={ type === "login" ? "current-password" : "new-password" }
        />
    </div>

    <p id="error" role="alert" class="text-[15px] text-charge empty:hidden"></p>

    <button class="button" type="submit">
        { type === "login" ? "Log in" : "Sign up"}
    </button>
</form>

<p class="mt-5 text-[15px] text-soft">
    { type === "login" ? "Don't have an account?" : "Already have an account?"}{" "}
    <a href={ type === "login" ? "/signup" : "/"} class="link">
        { type === "login" ? "Sign up" : "Log in"}
    </a>
</p>
