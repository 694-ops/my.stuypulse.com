---
import Battery from "./Battery.astro"
import { sampleCells } from "../lib/charge"
---

<div class="page-width min-h-dvh flex flex-col py-6">
    <header class="flex items-center gap-2 min-h-11 font-display font-semibold text-[17px] tracking-[-0.01em]">
        <img src="/694-logo.svg" alt="" class="size-6" />
        MyPulse
    </header>
    <div class="flex-1 grid lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] items-center gap-10 lg:gap-20 py-8">
        <aside class="order-2 lg:order-1" aria-label="About MyPulse">
            <p class="hidden lg:block headline mb-3">StuyPulse Attendance</p>
            <p class="hidden lg:block text-soft mb-10">FRC Team 694</p>
            <Battery cells={sampleCells()} decorative />
        </aside>
        <main class="order-1 lg:order-2 w-full max-w-[400px]">
            <slot />
        </main>
    </div>
</div>
