---
import { formatPercent } from "../lib/format"

interface Props {
    userData: {
        id_number: string
        num_checkins: number
        attendance_rate_percent: string
        num_checkouts: number
        checkout_rate_percent: string
        total_hours: number
        average_hours: number
    }
}

const { userData } = Astro.props

const numbers = userData && [
    { label: "hours in the shop", value: userData.total_hours },
    { label: "hours at a typical meeting", value: userData.average_hours },
    { label: "attendance rate", value: formatPercent(userData.attendance_rate_percent) },
    { label: "check-ins", value: userData.num_checkins },
    { label: "checkouts", value: userData.num_checkouts },
    { label: "checkout rate", value: formatPercent(userData.checkout_rate_percent) },
]
---

{
    numbers ? (
        <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-5">
            {
                numbers.map(({ label, value }) => (
                    <div class="flex flex-col-reverse justify-end">
                        <dt class="text-[15px] text-soft">{label}</dt>
                        <dd class="figure text-[28px]">{value}</dd>
                    </div>
                ))
            }
        </dl>
    ) : (
        <p>Your numbers couldn't load. Refresh the page to try again.</p>
    )
}
